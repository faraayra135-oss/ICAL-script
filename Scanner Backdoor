-- 2. DATABASE NAMA BACKDOOR (Signatures)
-- Ini adalah nama-nama remote yang sering dipakai virus
local SuspiciousNames = {
    "Backdoor", "Admin", "Run", "Client", "Monster", "Sanity", 
    "V5", "By", "Destruction", "M67", "Redweeb", "Xeon",
    "IIl", "l1l", "1l1", -- Obfuscated names
    "LoadString", "Get", "Post"
}

-- 3. FUNGSI LOGGING
local function AddLog(Text, IsBad)
    local Label = Instance.new("TextLabel")
    Label.Parent = LogScroll
    Label.Size = UDim2.new(1, 0, 0, 25)
    Label.BackgroundTransparency = 1
    Label.Text = Text
    Label.Font = Enum.Font.Code
    Label.TextSize = 12
    Label.TextXAlignment = Enum.TextXAlignment.Left
    
    if IsBad then
        Label.TextColor3 = Color3.fromRGB(255, 100, 100) -- Merah
    else
        Label.TextColor3 = Color3.fromRGB(100, 255, 100) -- Hijau
    end
    
    -- Auto Scroll ke bawah
    LogScroll.CanvasPosition = Vector2.new(0, 9999)
end

-- 4. LOGIKA SCANNER
ScanBtn.MouseButton1Click:Connect(function()
    -- Bersihkan Log Lama
    for _, v in pairs(LogScroll:GetChildren()) do
        if v:IsA("TextLabel") then v:Destroy() end
    end
    
    ScanBtn.Text = "⏳ SEDANG MEMINDAI..."
    AddLog("[*] Memulai Scan...", false)
    
    local FoundCount = 0
    local ServicesToScan = {
        game:GetService("Workspace"),
        game:GetService("ReplicatedStorage"),
        game:GetService("Lighting"),
        game:GetService("SoundService"),
        game:GetService("JointsService")
    }
    
    -- Loop Service
    for _, service in pairs(ServicesToScan) do
        -- Gunakan pcall biar gak crash kalau akses ditolak
        pcall(function()
            for _, obj in pairs(service:GetDescendants()) do
                if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
                    local Name = string.lower(obj.Name)
                    local IsSus = false
                    
                    -- Cek Nama
                    for _, keyword in pairs(SuspiciousNames) do
                        if string.find(Name, string.lower(keyword)) then
                            IsSus = true
                            break
                        end
                    end
                    
                    -- Cek Remote Tanpa Nama (Sering dipakai virus)
                    if Name == "" or Name == " " then IsSus = true end
                    
                    if IsSus then
                        FoundCount = FoundCount + 1
                        AddLog("⚠ " .. obj.Name .. " (@" .. obj.Parent.Name .. ")", true)
                        print("BACKDOOR FOUND: " .. obj:GetFullName())
                    end
                end
            end
        end)
    end
    
    task.wait(0.5)
    
    if FoundCount > 0 then
        AddLog("🚨 DITEMUKAN " .. FoundCount .. " REMOTE SUSPEK!", true)
        ScanBtn.Text = "❌ ADA POTENSI BAHAYA"
        ScanBtn.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
    else
        AddLog("✅ Tidak ditemukan remote umum.", false)
        ScanBtn.Text = "✅ AMAN / BERSIH"
        ScanBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
    end
    
    task.delay(3, function()
        ScanBtn.Text = "🔍 MULAI SCANNING"
        ScanBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
    end)
end)

