end)

-- Logic Toggle Features
ToggleWhizz.MouseButton1Click:Connect(function()
    WhizzActive = not WhizzActive
    if WhizzActive then
        ToggleWhizz.Text = "🔊 WHIZZ: ON"
        ToggleWhizz.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
    else
        ToggleWhizz.Text = "🔊 WHIZZ: OFF"
