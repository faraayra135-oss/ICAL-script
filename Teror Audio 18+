-- Refresh Player List
local function RefreshPlayers()
    -- Hapus tombol lama
    for _, child in pairs(ScrollList:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    
    -- Buat tombol baru
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local pBtn = Instance.new("TextButton", ScrollList)
            pBtn.Name = player.Name
            pBtn.Text = player.Name
            pBtn.Size = UDim2.new(1, -10, 0, 30)
            pBtn.Font = Enum.Font.Gotham
            pBtn.TextColor3 = Color3.new(1,1,1)
            pBtn.TextSize = 14
            
            -- Cek apakah dia sudah dipilih
            if SelectedTargets[player.Name] then
                pBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 0) -- Hijau
            else
                pBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60) -- Abu
            end
            
            -- Logic Klik Player
            pBtn.MouseButton1Click:Connect(function()
                if SelectedTargets[player.Name] then
                    SelectedTargets[player.Name] = nil
                    pBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
                else
                    SelectedTargets[player.Name] = true
                    pBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
                end
            end)
        end
    end
end

-- Refresh saat player join/leave
Players.PlayerAdded:Connect(RefreshPlayers)
Players.PlayerRemoving:Connect(RefreshPlayers)
RefreshPlayers()

-- Logic Select All
SelectAllBtn.MouseButton1Click:Connect(function()
    TargetAllMode = not TargetAllMode
    if TargetAllMode then
        SelectAllBtn.Text = "SELECT ALL: ON"
        SelectAllBtn.BackgroundColor3 = Color3.fromRGB(200, 100, 0)
        -- Disable manual selection visual
        for _, btn in pairs(ScrollList:GetChildren()) do
            if btn:IsA("TextButton") then btn.BackgroundColor3 = Color3.fromRGB(100, 100, 100) end
        end
    else
        SelectAllBtn.Text = "SELECT ALL: OFF"
        SelectAllBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
        RefreshPlayers() -- Reset warna
    end
end)

-- Logic Minimize
