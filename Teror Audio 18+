end)

-- ==============================
-- 5. SPAM LOOPS
-- ==============================

-- Loop Whizz (Cepat)
task.spawn(function()
    while true do
        if WhizzActive then
            if TargetAllMode then
                for _, p in pairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer then pcall(function() WhizzRemote:FireServer(p) end) end
                end
            else
                for name, _ in pairs(SelectedTargets) do
                    local p = Players:FindFirstChild(name)
                    if p then pcall(function() WhizzRemote:FireServer(p) end) end
                end
            end
            task.wait(0.01) -- Speed Whizz
        else
            task.wait(0.5)
        end
    end
end)

-- Loop Suppression (Sedang)
task.spawn(function()
    while true do
        if SuppressActive then
            if TargetAllMode then
                for _, p in pairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer then pcall(function() SuppressRemote:FireServer(p, 100) end) end
                end
            else
                for name, _ in pairs(SelectedTargets) do
                    local p = Players:FindFirstChild(name)
                    if p then pcall(function() SuppressRemote:FireServer(p, 100) end) end
                end
            end
            task.wait(0.1) -- Speed Suppression
        else
            task.wait(0.5)
        end
    end
end)
