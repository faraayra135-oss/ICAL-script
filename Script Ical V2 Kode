--[[
    ICAL HUB V2 - PREMIUM AUTH LOADER
    "Salin dulu codenya bro!!" Version
]]

local WhitelistURL = "https://pastebin.com/raw/PHBaMu4J"
local MainScriptURL = "https://raw.githubusercontent.com/faraayra135-oss/ICAL-script/refs/heads/main/Script%20Ical%20V2%20lengkap"

local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local TweenService = game:GetService("TweenService")

-- 1. FUNGSI AMBIL HWID
local function GetHWID()
    local id = (gethwid and gethwid()) or (get_hwid and get_hwid()) or game:GetService("RbxAnalyticsService"):GetClientId()
    return string.gsub(id, "%s+", "")
end

local userHWID = GetHWID()

-- 2. SETUP GUI
if CoreGui:FindFirstChild("ICAL_PremiumAuth") then CoreGui.ICAL_PremiumAuth:Destroy() end
local Screen = Instance.new("ScreenGui", CoreGui)
Screen.Name = "ICAL_PremiumAuth"

-- Background Utama
local Main = Instance.new("Frame", Screen)
Main.Size = UDim2.new(1, 0, 1, 0)
Main.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
Main.ZIndex = 10000

-- Panel Tengah (Pop-up Feel)
local Panel = Instance.new("Frame", Main)
Panel.Size = UDim2.new(0, 300, 0, 220)
Panel.Position = UDim2.new(0.5, -150, 0.4, -110)
Panel.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
Instance.new("UICorner", Panel).CornerRadius = UDim.new(0, 15)
local Stroke = Instance.new("UIStroke", Panel)
Stroke.Color = Color3.fromRGB(0, 150, 255)
Stroke.Thickness = 2

-- Judul Atas
local Title = Instance.new("TextLabel", Panel)
Title.Size = UDim2.new(1, 0, 0, 40)
Title.BackgroundTransparency = 1
Title.Font = Enum.Font.GothamBold
Title.Text = "ICAL HUB V2 ACCESS"
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.TextSize = 16

-- Status & Pesan Khusus
local Status = Instance.new("TextLabel", Panel)
Status.Size = UDim2.new(1, 0, 0, 30)
Status.Position = UDim2.new(0, 0, 0.25, 0)
Status.BackgroundTransparency = 1
Status.Font = Enum.Font.GothamBold
Status.Text = "MEMERIKSA AKSES..."
Status.TextColor3 = Color3.fromRGB(255, 255, 255)
Status.TextSize = 14

-- 3. LOGIKA PENGECEKAN
local success, database = pcall(function()
    return game:HttpGet(WhitelistURL)
end)

task.wait(1) -- Delay biar keren

if success then
    local cleanDB = string.gsub(database, "%s+", " ")

    if string.find(cleanDB, userHWID) then
        -- SUKSES
        Status.Text = "AKSES DITERIMA!"
        Status.TextColor3 = Color3.fromRGB(0, 255, 100)
        Stroke.Color = Color3.fromRGB(0, 255, 100)
        task.wait(1)
        Screen:Destroy()
        loadstring(game:HttpGet(MainScriptURL))()
    else
        -- GAGAL (Tampilkan Menu Menarik)
        Status.Text = "AKSES DITOLAK!"
        Status.TextColor3 = Color3.fromRGB(255, 50, 50)
        Stroke.Color = Color3.fromRGB(255, 50, 50)

        -- Tulisan yang kamu minta
        local BroMsg = Instance.new("TextLabel", Panel)
        BroMsg.Size = UDim2.new(1, 0, 0, 20)
        BroMsg.Position = UDim2.new(0, 0, 0.4, 0)
        BroMsg.BackgroundTransparency = 1
        BroMsg.Font = Enum.Font.GothamBold
        BroMsg.Text = "Salin dulu codenya bro!!"
        BroMsg.TextColor3 = Color3.fromRGB(255, 255, 0) -- Kuning biar kebaca
        BroMsg.TextSize = 18

        -- Box HWID
        local Box = Instance.new("TextBox", Panel)
        Box.Size = UDim2.new(0.8, 0, 0, 35)
        Box.Position = UDim2.new(0.1, 0, 0.55, 0)
        Box.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
        Box.TextColor3 = Color3.fromRGB(200, 200, 200)
        Box.Text = userHWID
        Box.ClearTextOnFocus = false
        Box.ReadOnly = true
        Box.Font = Enum.Font.Code
        Box.TextSize = 12
        Instance.new("UICorner", Box).CornerRadius = UDim.new(0, 8)

        -- Tombol Salin (Copy)
        local CopyBtn = Instance.new("TextButton", Panel)
        CopyBtn.Size = UDim2.new(0.8, 0, 0, 40)
        CopyBtn.Position = UDim2.new(0.1, 0, 0.75, 0)
        CopyBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
        CopyBtn.Font = Enum.Font.GothamBold
        CopyBtn.Text = "SALIN HWID (COPY)"
        CopyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        CopyBtn.TextSize = 14
        Instance.new("UICorner", CopyBtn).CornerRadius = UDim.new(0, 8)

        CopyBtn.MouseButton1Click:Connect(function()
            if setclipboard then
                setclipboard(userHWID)
                CopyBtn.Text = "SUKSES DISALIN!"
                CopyBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
                task.wait(2)
                CopyBtn.Text = "SALIN HWID (COPY)"
                CopyBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
            else
                CopyBtn.Text = "Gagal Salin (Manual)"
            end
        end)
    end
else
    Status.Text = "SERVER DATABASE OFFLINE"
    Status.TextColor3 = Color3.fromRGB(255, 150, 0)
end
