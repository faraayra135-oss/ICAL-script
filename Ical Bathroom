-- FUNGSI MEMBUAT TOMBOL SCRIPT
local function CreateScriptBtn(text, url, color)
    local Btn = Instance.new("TextButton")
    Btn.Parent = ButtonContainer
    Btn.BackgroundColor3 = color or Color3.fromRGB(60, 60, 60)
    Btn.Size = UDim2.new(1, 0, 0, 45)
    Btn.Font = Enum.Font.GothamSemibold
    Btn.Text = text
    Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    Btn.TextSize = 14
    Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 8)

    Btn.MouseButton1Click:Connect(function()
        -- Efek Klik
        Btn.Text = "Loading..."
        Btn.BackgroundColor3 = Color3.fromRGB(255, 200, 0) -- Kuning loading
        
        -- Jalankan Loadstring
        task.spawn(function()
            local success, err = pcall(function()
                loadstring(game:HttpGet(url))()
            end)
            
            if success then
                Btn.Text = "BERHASIL!"
                Btn.BackgroundColor3 = Color3.fromRGB(0, 200, 100) -- Hijau
                task.wait(1)
                Btn.Text = text
                Btn.BackgroundColor3 = color or Color3.fromRGB(60, 60, 60)
            else
                Btn.Text = "ERROR!"
                Btn.BackgroundColor3 = Color3.fromRGB(200, 50, 50) -- Merah
                warn("Script Error: " .. err)
                task.wait(1)
                Btn.Text = text
                Btn.BackgroundColor3 = color or Color3.fromRGB(60, 60, 60)
            end
        end)
    end)
end

