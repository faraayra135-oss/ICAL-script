-- ACS Unlimited Ammo Script
local RunService = game:GetService("RunService")
local player = game.Players.LocalPlayer

print("ACS Unlimited Ammo Aktif...")

RunService.RenderStepped:Connect(function()
    -- Mencari di Backpack dan Character (saat sedang dipegang)
    local items = {}
    for _, v in pairs(player.Backpack:GetChildren()) do table.insert(items, v) end
    if player.Character then
        for _, v in pairs(player.Character:GetChildren()) do table.insert(items, v) end
    end

    for _, tool in pairs(items) do
        if tool:IsA("Tool") then
            -- ACS biasanya menyimpan data di folder 'ACS_Settings' atau langsung di atribut
            local settings = tool:FindFirstChild("ACS_Settings") or tool:FindFirstChild("Settings")
            
            if settings and settings:IsA("ModuleScript") then
                -- Menggunakan getrenv atau mencoba mengubah nilai di dalam environment script
                local sTable = require(settings)
                
                if sTable.Ammo then
                    sTable.Ammo = 999 -- Set peluru di magasin sangat banyak
                end
                if sTable.MaxAmmo then
                    sTable.MaxAmmo = 999 -- Set cadangan peluru sangat banyak
                end
                if sTable.StoredAmmo then
                    sTable.StoredAmmo = 999
                end
            end
            
            -- Beberapa versi ACS menggunakan Atribut (Attributes)
            if tool:GetAttribute("Ammo") then
                tool:SetAttribute("Ammo", 999)
            end
        end
    end
end)
