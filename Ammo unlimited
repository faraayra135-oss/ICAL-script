-- ACS ULTIMATE WEAPON MOD (Ammo, Recoil, No Zoom)
local RunService = game:GetService("RunService")
local player = game.Players.LocalPlayer

print("ACS Weapon Mod: Aktif (No Recoil & No Zoom)...")

RunService.RenderStepped:Connect(function()
    -- Cek item di Backpack dan di tangan (Character)
    local items = {}
    if player.Backpack then
        for _, v in pairs(player.Backpack:GetChildren()) do table.insert(items, v) end
    end
    if player.Character then
        for _, v in pairs(player.Character:GetChildren()) do table.insert(items, v) end
    end

    for _, tool in pairs(items) do
        if tool:IsA("Tool") then
            -- Cari Module Settings ACS
            local settings = tool:FindFirstChild("ACS_Settings") or tool:FindFirstChild("Settings")
            
            if settings and settings:IsA("ModuleScript") then
                local sTable = require(settings)
                
                -- 1. UNLIMITED AMMO
                sTable.Ammo = 999
                sTable.MaxAmmo = 999
                sTable.StoredAmmo = 999
                
                -- 2. NO RECOIL & NO SPREAD (Akurasi 100%)
                sTable.RecoilPower = 0
                sTable.MaxRecoil = 0
                sTable.RecoilPowerX = 0
                sTable.RecoilPowerY = 0
                sTable.Spread = 0
                sTable.AimSpread = 0
                
                -- 3. NO ZOOM & NO CAMERA EFFECTS
                -- Mematikan perubahan FOV (Field of View) agar kamera tidak zoom
                sTable.ZoomFOV = 70 -- Set ke FOV standar Roblox (biasanya 70)
                sTable.AimFOV = 70  -- Membuat saat membidik tetap di FOV normal
                
                -- Mematikan efek goyangan kamera (Camera Shake)
                if sTable.CamShake then sTable.CamShake = false end
                if sTable.CanZoom then sTable.CanZoom = false end -- Opsi tambahan beberapa versi
                
            end
        end
    end
end)

-- SCRIPT TAMBAHAN UNTUK MEMAKSA FOV TETAP NORMAL
-- (Mencegah script internal ACS memaksa kamera zoom)
player.CameraMaxZoomDistance = 100 -- Menghindari pembatasan kamera
local camera = workspace.CurrentCamera
camera:GetPropertyChangedSignal("FieldOfView"):Connect(function()
    if camera.FieldOfView ~= 70 then
        camera.FieldOfView = 70
    end
end)
