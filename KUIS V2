--- LOGIKA DATABASE ---
local WordList = {}
local WordCheck = {}
_G.kataSudahDipakai = {}

local function addWordsFromUrl(url)
    local success, result = pcall(function() return game:HttpGet(url) end)
    if success and result then
        for word in result:gmatch("[^\r\n]+") do
            local clean = word:match("^%s*(.-)%s*$"):lower()
            if #clean >= 2 and not clean:find("%s") and not clean:find("-") and not WordCheck[clean] then
                table.insert(WordList, clean)
                WordCheck[clean] = true
            end
        end
        return true
    end
    return false
end

task.spawn(function()
    addWordsFromUrl("https://raw.githubusercontent.com/geovedi/indonesian-wordlist/master/01-kbbi3-2001-sort-alpha.lst")
