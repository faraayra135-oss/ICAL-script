-- [[ ANTI-CRIMINAL / ANTI-WANTED ]]
-- Mencoba memblokir Remote Event yang memicu status Criminal

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

-- DAFTAR KATA KUNCI (BLACKLIST)
-- Script akan memblokir remote yang mengandung kata-kata ini:
local Blacklist = {
    "Wanted",
    "Criminal",
    "Crime",
    "Guilty",
    "Report",
    "Punish",
    "TeamKill",
    "ChangeTeam",
    "Flag"
}

-- 1. REMOTE BLOCKER
local mt = getrawmetatable(game)
local oldNamecall = mt.__namecall
setreadonly(mt, false)

mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    local RemoteName = self.Name

    if method == "FireServer" or method == "InvokeServer" then
        -- Cek apakah nama remote mengandung kata terlarang
        for _, keyword in pairs(Blacklist) do
            if string.find(RemoteName, keyword) then
                -- BLOKIR!
                print("🛡️ BLOCKED: Mencegah status " .. RemoteName)
                return nil 
            end
        end
        
        -- Cek argumen (kadang status dikirim lewat argumen string)
        for _, arg in pairs(args) do
            if type(arg) == "string" then
                if arg == "Criminal" or arg == "Hostile" then
                    print("🛡️ BLOCKED: Mencegah perubahan status ke Criminal")
                    return nil
                end
            end
        end
    end

    return oldNamecall(self, ...)
end)

setreadonly(mt, true)

-- 2. AUTO RESET TEAM (Looping)
-- Mencoba memaksa tim kembali ke Civilian/Police secara lokal
local function ResetTeam()
    local MyTeam = Players.LocalPlayer.Team
    if MyTeam and (MyTeam.Name == "Criminal" or MyTeam.Name == "Hostile") then
        -- Coba cari tim yang aman
        local SafeTeam = game:GetService("Teams"):FindFirstChild("Civilian") or game:GetService("Teams"):FindFirstChild("Police")
        if SafeTeam then
            -- Note: Ini mungkin hanya visual di client, tapi patut dicoba
            Players.LocalPlayer.Team = SafeTeam
        end
    end
end

-- 3. HAPUS LABEL DI KEPALA (Visual)
game:GetService("RunService").RenderStepped:Connect(function()
    pcall(function()
        -- Reset Team jika berubah
        ResetTeam()
        
        -- Hapus Overhead UI yang bertuliskan Criminal
        local Char = Players.LocalPlayer.Character
        local Head = Char and Char:FindFirstChild("Head")
        if Head then
            for _, gui in pairs(Head:GetChildren()) do
                if gui:IsA("BillboardGui") or gui:IsA("SurfaceGui") then
                    -- Cari textlabel di dalamnya
                    for _, label in pairs(gui:GetDescendants()) do
                        if label:IsA("TextLabel") and (string.find(label.Text, "Criminal") or label.TextColor3 == Color3.new(1,0,0)) then
                            gui:Destroy() -- Hapus tag merah
                        end
                    end
                end
            end
        end
    end)
end)

game.StarterGui:SetCore("SendNotification", {
    Title = "Anti-Criminal Active";
    Text = "Mencoba memblokir status jahat.";
    Duration = 5;
})
