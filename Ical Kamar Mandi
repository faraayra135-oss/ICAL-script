-- SCRIPT 5: ESP WALLHACK (LOCAL CODE INTEGRATED)
CreateBtn("5. ESP Wallhack", Color3.fromRGB(150, 50, 200), function()
    -- [[ KODE ESP V2 FIXED DIINTEGRASIKAN DI SINI ]] --
    
    local CoreGui = game:GetService("CoreGui")
    -- Reset jika sudah ada
    if CoreGui:FindFirstChild("ESPGUI_Fixed") then
        CoreGui:FindFirstChild("ESPGUI_Fixed"):Destroy()
    end

    -- GUI Setup
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "ESPGUI_Fixed"
    ScreenGui.Parent = CoreGui

    -- Tombol Buka ESP (Kecil)
    local OpenESP = Instance.new("TextButton")
    OpenESP.Name = "OpenESP"
    OpenESP.Parent = ScreenGui
    OpenESP.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
    OpenESP.Position = UDim2.new(0.02, 0, 0.5, 0)
    OpenESP.Size = UDim2.new(0, 45, 0, 45)
    OpenESP.Text = "ESP"
    OpenESP.TextColor3 = Color3.fromRGB(255,255,255)
    OpenESP.Font = Enum.Font.GothamBold
    OpenESP.Visible = false
    OpenESP.Draggable = true
    OpenESP.Active = true
    Instance.new("UICorner", OpenESP).CornerRadius = UDim.new(0,10)
    Instance.new("UIStroke", OpenESP).Color = Color3.fromRGB(255,255,255)

    -- Menu ESP Utama
    local ESPFrame = Instance.new("Frame")
    ESPFrame.Parent = ScreenGui
    ESPFrame.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    ESPFrame.Position = UDim2.new(0.2, 0, 0.3, 0)
    ESPFrame.Size = UDim2.new(0, 160, 0, 140)
    ESPFrame.Draggable = true
    ESPFrame.Active = true
    Instance.new("UICorner", ESPFrame).CornerRadius = UDim.new(0,10)

    local ESPHeader = Instance.new("Frame")
    ESPHeader.Parent = ESPFrame
    ESPHeader.BackgroundColor3 = Color3.fromRGB(50,50,50)
    ESPHeader.Size = UDim2.new(1,0,0,30)
    Instance.new("UICorner", ESPHeader).CornerRadius = UDim.new(0,10)

    local ESPTitle = Instance.new("TextLabel")
    ESPTitle.Parent = ESPHeader
    ESPTitle.Text = "ESP MENU"
    ESPTitle.TextColor3 = Color3.fromRGB(255,255,255)
    ESPTitle.BackgroundTransparency = 1
    ESPTitle.Size = UDim2.new(0.7,0,1,0)
    ESPTitle.Font = Enum.Font.GothamBold
    ESPTitle.TextSize = 14

    local ESPClose = Instance.new("TextButton")
    ESPClose.Parent = ESPHeader
    ESPClose.Text = "X"
    ESPClose.TextColor3 = Color3.fromRGB(255,255,255)
    ESPClose.BackgroundColor3 = Color3.fromRGB(200,50,50)
    ESPClose.Position = UDim2.new(0.8,0,0.1,0)
    ESPClose.Size = UDim2.new(0,24,0,24)
    Instance.new("UICorner", ESPClose).CornerRadius = UDim.new(0,5)

    local ESPToggle = Instance.new("TextButton")
    ESPToggle.Parent = ESPFrame
    ESPToggle.Text = "STATUS: OFF"
    ESPToggle.BackgroundColor3 = Color3.fromRGB(60,60,60)
    ESPToggle.TextColor3 = Color3.fromRGB(255,255,255)
    ESPToggle.Position = UDim2.new(0.1,0,0.4,0)
    ESPToggle.Size = UDim2.new(0.8,0,0.4,0)
    ESPToggle.Font = Enum.Font.GothamBold
    ESPToggle.TextSize = 16
    Instance.new("UICorner", ESPToggle).CornerRadius = UDim.new(0,8)

    -- Logic ESP
    local espEnabled = false
    
    local function CreateESP(plr)
        if plr == LocalPlayer or not plr.Character then return end
        local head = plr.Character:FindFirstChild("Head")
        if not head then return end
        
        -- Bersihkan lama
        if plr.Character:FindFirstChild("ESPHighlight") then plr.Character.ESPHighlight:Destroy() end
        if plr.Character:FindFirstChild("ESPNameTag") then plr.Character.ESPNameTag:Destroy() end
        
        -- Highlight
        local hl = Instance.new("Highlight")
        hl.Name = "ESPHighlight"
        hl.Parent = plr.Character
        hl.FillColor = Color3.fromRGB(255,0,0)
        hl.OutlineColor = Color3.fromRGB(255,255,255)
        hl.FillTransparency = 0.5
        hl.OutlineTransparency = 0
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        
        -- Name Tag
        local bg = Instance.new("BillboardGui")
        bg.Name = "ESPNameTag"
        bg.Parent = plr.Character
        bg.Adornee = head
        bg.Size = UDim2.new(0,100,0,50)
        bg.StudsOffset = Vector3.new(0,2,0)
        bg.AlwaysOnTop = true
        
        local txt = Instance.new("TextLabel")
        txt.Parent = bg
        txt.BackgroundTransparency = 1
        txt.Size = UDim2.new(1,0,1,0)
        txt.Text = plr.Name
        txt.TextColor3 = Color3.fromRGB(255,255,0)
        txt.Font = Enum.Font.GothamBold
        txt.TextStrokeTransparency = 0
        
        task.spawn(function()
            while plr.Character and bg.Parent and CoreGui:FindFirstChild("ESPGUI_Fixed") do
                if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and plr.Character:FindFirstChild("HumanoidRootPart") then
                    local dist = (LocalPlayer.Character.HumanoidRootPart.Position - plr.Character.HumanoidRootPart.Position).Magnitude
                    txt.Text = plr.Name .. "\n["..math.floor(dist).."m]"
                end
                task.wait(0.5)
            end
        end)
    end

    local function RemoveESP()
        for _, v in pairs(Players:GetPlayers()) do
            if v.Character then
                if v.Character:FindFirstChild("ESPHighlight") then v.Character.ESPHighlight:Destroy() end
                if v.Character:FindFirstChild("ESPNameTag") then v.Character.ESPNameTag:Destroy() end
            end
        end
    end

    -- Tombol Actions
    ESPClose.MouseButton1Click:Connect(function() ESPFrame.Visible = false OpenESP.Visible = true end)
    OpenESP.MouseButton1Click:Connect(function() ESPFrame.Visible = true OpenESP.Visible = false end)
    
    ESPToggle.MouseButton1Click:Connect(function()
        espEnabled = not espEnabled
        if espEnabled then
            ESPToggle.Text = "STATUS: ON"
            ESPToggle.BackgroundColor3 = Color3.fromRGB(0,200,100)
            for _, v in pairs(Players:GetPlayers()) do CreateESP(v) end
        else
            ESPToggle.Text = "STATUS: OFF"
            ESPToggle.BackgroundColor3 = Color3.fromRGB(60,60,60)
            RemoveESP()
        end
    end)
    
    -- Auto Update
    RunService.RenderStepped:Connect(function()
        if not espEnabled or not CoreGui:FindFirstChild("ESPGUI_Fixed") then return end
        for _, v in pairs(Players:GetPlayers()) do
            if v ~= LocalPlayer and v.Character and not v.Character:FindFirstChild("ESPHighlight") then
                CreateESP(v)
            end
        end
    end)
    
    Players.PlayerAdded:Connect(function(v)
        v.CharacterAdded:Connect(function()
            if espEnabled then task.wait(1) CreateESP(v) end
        end)
    end)
end)

