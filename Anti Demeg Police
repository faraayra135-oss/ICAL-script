local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local RunService = game:GetService("RunService")

print("🧼 AUTO CLEANER AKTIF: Otomatis menghapus status Criminal...")

-- 1. Cari Remote Ganti Tim
local TeamRemote = nil
local function ScanRemotes()
    for _, v in pairs(ReplicatedStorage:GetDescendants()) do
        if v:IsA("RemoteEvent") and (string.find(v.Name, "Team") or string.find(v.Name, "Change")) then
            print("🔎 Remote Tim ditemukan: " .. v.Name)
            TeamRemote = v
        end
    end
end
ScanRemotes()

-- 2. Loop Pembersih
RunService.Heartbeat:Connect(function()
    -- Cek apakah kita Criminal? (Biasanya ditandai dengan Team Color atau Nama Team)
    if LocalPlayer.Team and string.find(LocalPlayer.Team.Name, "Criminal") then
        print("🚨 TERDETEKSI CRIMINAL! Melakukan Cuci Nama...")
        
        if TeamRemote then
            -- Spam ganti tim ke Civilian
            -- Sesuaikan nama tim "Civilian" dengan yang ada di game (bisa "Citizen", "Warga", dll)
            pcall(function() TeamRemote:FireServer("Civilian") end)
            pcall(function() TeamRemote:FireServer("Citizen") end)
            
            -- Kadang pakai TeamColor
            pcall(function() TeamRemote:FireServer(BrickColor.new("White")) end) -- Putih biasanya Civilian
        end
    end
end)
