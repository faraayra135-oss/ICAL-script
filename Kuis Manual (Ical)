end)

local function cariKataCrusher()
    local prefix = string.match(string.lower(InputBox.Text), "^%s*(.-)%s*$")
    local rawSuffix = string.lower(SuffixBox.Text)
    local minLen = tonumber(MinLenBox.Text) or 3
    local maxLen = tonumber(MaxLenBox.Text) or 10
    
    if not prefix or #prefix == 0 or #WordList == 0 then return nil end
    local targets = {}
    for s in rawSuffix:gmatch("([^,%s]+)") do table.insert(targets, s) end
    
    local hasil = {}
    for _, w in ipairs(WordList) do
        if w:sub(1, #prefix) == prefix and not _G.kataSudahDipakai[w] then
            if #w >= minLen and #w <= maxLen then
                local score = 0
                local isSpecial = false
                
                for i, target in ipairs(targets) do
                    if w:sub(-#target) == target then
                        -- SKOR SUPER PRIORITAS
                        score = 1000000 - (i * 1000) + (100 - #w)
                        isSpecial = true
                        break
                    end
                end
                
                if not isSpecial then
                    score = (100 - #w) -- Prioritas kata pendek untuk kata biasa
                end
                
                table.insert(hasil, {t = w, p = score})
            end
        end
    end
    
    table.sort(hasil, function(a, b) return a.p > b.p end)
    return #hasil > 0 and hasil[1].t or nil
end

local function eksekusi(target, pfx)
    local minS = tonumber(MinSpeedBox.Text) or 13
    local maxS = tonumber(MaxSpeedBox.Text) or 25
    StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 150)
    StatusLabel.Text = "HASIL: " .. target:upper()
    
    for i = #pfx + 1, #target do
        task.wait(math.random(minS, maxS) / 100)
    end
    
    _G.kataSudahDipakai[target] = true
    local c = 0; for _ in pairs(_G.kataSudahDipakai) do c = c + 1 end
    ResetBtn.Text = "RESET MEMORY (" .. c .. ")"
end

InputBox.FocusLost:Connect(function(enter)
    if enter then
        local p = string.match(InputBox.Text, "^%s*(.-)%s*$") or InputBox.Text
        local res = cariKataCrusher()
        if res then
            InputBox.Text = ""
            task.spawn(function() eksekusi(res, p) end)
        else
            StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
            StatusLabel.Text = "TIDAK ADA KATA!"
        end
    end
end)

