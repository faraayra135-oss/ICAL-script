-- Loader untuk Custom dan Teks Biasa
local function loadGeneric(name, url_or_table)
    StatusLabel.Text = "Loading: " .. name
    local content
    if type(url_or_table) == "table" then
        content = url_or_table
    else
        local ok, res = pcall(function() return game:HttpGet(url_or_table) end)
        if ok then content = res else warn("Gagal load " .. name) return end
    end

    if type(content) == "string" then
        for word in content:gmatch("[^\r\n]+") do
            local clean = word:match("^%s*(.-)%s*$"):lower():gsub("[^%a]", "")
            if #clean >= 2 and not WordCheck[clean] then
                table.insert(WordList, clean)
                WordCheck[clean] = true
            end
        end
    else
        for _, word in ipairs(content) do
            local clean = word:lower():gsub("[^%a]", "")
            if #clean >= 2 and not WordCheck[clean] then
                table.insert(WordList, clean)
                WordCheck[clean] = true
            end
        end
    end
end

-- Loader khusus JSON
local function loadJSON(url)
    StatusLabel.Text = "Loading: JSON KBBI"
    local ok, res = pcall(function() return game:HttpGet(url) end)
    if ok then
        local data = HttpService:JSONDecode(res)
        for _, entry in pairs(data) do
            local wordStr = type(entry) == "table" and entry.kata or tostring(entry)
            local clean = wordStr:lower():gsub("[^%a]", "")
            if #clean >= 3 and not WordCheck[clean] then
                table.insert(WordList, clean)
                WordCheck[clean] = true
            end
        end
    end
end

