--- LOGIKA DATABASE DENGAN FILTER MIN 3 HURUF ---
local WordList = {}
local WordCheck = {}
_G.kataSudahDipakai = {}

local sources = {
    "https://raw.githubusercontent.com/geovedi/indonesian-wordlist/master/00-indonesian-wordlist.lst",
}

local function addWordsFromUrl(url)
    local success, result = pcall(function() return game:HttpGet(url) end)
    if success and result then
        local added = 0
        for word in result:gmatch("[^\r\n]+") do
            local clean = word:match("^%s*(.-)%s*$"):lower()
            -- FILTER: Minimal 3 Huruf, Tanpa Spasi, Tanpa Simbol
            if #clean >= 3 and not clean:find("%s") and not clean:find("[^%a]") and not WordCheck[clean] then
                table.insert(WordList, clean)
                WordCheck[clean] = true
                added = added + 1
            end
        end
    end
end

task.spawn(function()
    for _, src in ipairs(sources) do
        addWordsFromUrl(src)
        StatusLabel.Text = "Database: " .. #WordList .. " Kata"
        task.wait(0.1)
    end
    StatusLabel.Text = "Ready (Minimal 3 Huruf)"
end)

local function eksekusi(target, originalPrefix)
    local RS = game:GetService("ReplicatedStorage")
    local Remotes = RS:WaitForChild("Remotes", 5)
    if not Remotes then return end
    
    local Billboard = Remotes:FindFirstChild("BillboardUpdate")
    local TypeSound = Remotes:FindFirstChild("TypeSound")
    local Submit = Remotes:FindFirstChild("SubmitWord")
    
    local minSpd = tonumber(MinSpeedBox.Text) or 13
    local maxSpd = tonumber(MaxSpeedBox.Text) or 25
    
    StatusLabel.Text = "Ketik: " .. target:upper()
    task.wait(math.random(3, 5) / 10)

    for i = #originalPrefix + 1, #target do
        local currentText = string.sub(target, 1, i)
        if Billboard then Billboard:FireServer(currentText) end
        if TypeSound then TypeSound:FireServer() end
        task.wait(math.random(minSpd, maxSpd) / 100)
    end
    
    task.wait(math.random(4, 7) / 10)
    if Submit then 
        Submit:FireServer(target)
        _G.kataSudahDipakai[target] = true
        local count = 0; for _ in pairs(_G.kataSudahDipakai) do count = count + 1 end
        ResetBtn.Text = "RESET MEMORY (" .. count .. ")"
        StatusLabel.Text = "Terkirim: " .. target:upper()
    end
end

local function cariKataCrusher()
    local prefix = string.lower(InputBox.Text)
    local rawSuffix = string.lower(SuffixBox.Text)
    local maxAllowed = tonumber(MaxLenBox.Text) or 10
    if #prefix == 0 or #WordList == 0 then return nil end
    local targets = {}
    for s in rawSuffix:gmatch("([^,%s]+)") do table.insert(targets, s) end
    local hasilCari = {}
    
    for _, w in ipairs(WordList) do
        if string.sub(w, 1, #prefix) == prefix and not _G.kataSudahDipakai[w] then
            local skor = 0
            local isUnderLimit = (#w <= maxAllowed)
            local limitBonus = isUnderLimit and 2000 or 0
            
            -- Cek kecocokan dengan kotak merah
            for i, target in ipairs(targets) do
                if string.sub(w, -#target) == target then
                    skor = 100000 + limitBonus - i 
                    break
                end
            end
            
            -- JIKA TIDAK ADA DI KOTAK MERAH, FOKUS KATA UMUM
            if skor == 0 then 
                -- Memprioritaskan kata yang lebih pendek.
                -- Semakin pendek kata (biasanya kata dasar yang umum), semakin tinggi skor tambahannya.
                skor = limitBonus + (50 - #w)
            end
            
            table.insert(hasilCari, {teks = w, poin = skor})
        end
    end
    table.sort(hasilCari, function(a, b) return a.poin > b.poin end)
    return #hasilCari > 0 and hasilCari[1].teks or nil
end

InputBox.FocusLost:Connect(function(enter)
    if enter then
        local pfx = InputBox.Text
        local target = cariKataCrusher()
        if target then
            InputBox.Text = ""
            task.spawn(function() eksekusi(target, pfx) end)
        else
            StatusLabel.Text = "Kata 3+ Huruf Tidak Ada!"
        end
    end
end)

