-- [[ ACS POLICE IDENTITY MASKER ]]
-- Memaksa sistem menganggap kamu adalah Police dan korban adalah Criminal
-- Agar tidak mendapatkan status "Wanted/Criminal" saat membunuh

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- 1. CARI MODULE ENUM
local function GetEnumModule()
    local Engine = ReplicatedStorage:WaitForChild("ACS_Engine", 10)
    if Engine then
        return Engine:WaitForChild("Modules"):WaitForChild("Enum")
    end
end

local EnumModule = GetEnumModule()
if not EnumModule then return warn("❌ Module Enum tidak ditemukan!") end

local EnumData = require(EnumModule)

-- 2. KONFIGURASI IDENTITY
-- Biasanya dalam ACS: 1 = Police/Law, 2 = Criminal/Hostile, 3 = Civilian
local POLICE_VALUE = 1 
local CRIMINAL_VALUE = 2

-- 3. HOOKING SISTEM ENUM
-- Kita cari kategori 'Teams' atau 'Side' di dalam Enum
local TeamEnum = EnumData.enums.Teams or EnumData.enums.Side or EnumData.enums.Team

if TeamEnum then
    -- Simpan fungsi asli
    local OldGetValue = TeamEnum.getValue
    local OldGetName = TeamEnum.getName

    -- BAJAK FUNGSI GETVALUE
    TeamEnum.getValue = function(self, input)
        local Result = OldGetValue(self, input)
        
        -- Jika sistem mengecek tim KITA, selalu jawab POLICE
        if tostring(input):find(LocalPlayer.Name) then
            return POLICE_VALUE
        end
        
        -- Jika sistem mengecek tim ORANG LAIN (Korban), selalu jawab CRIMINAL
        -- Logika: Membunuh Criminal tidak akan membuatmu jadi Criminal
        return CRIMINAL_VALUE 
    end

    -- BAJAK FUNGSI GETNAME
    TeamEnum.getName = function(self, input)
        if tostring(input):find(LocalPlayer.Name) then
            return "Police"
        end
        return "Criminal"
    end
    
    print("✅ Identity Masker Aktif: Kamu sekarang adalah Polisi Abadi.")
else
    warn("❌ Kategori 'Teams' tidak ditemukan di dalam Enum.")
end

-- 4. TAMBAHAN: REMOTE PROTECTOR
-- Memblokir sinyal 'SetCriminal' yang dikirim oleh client ke server
local mt = getrawmetatable(game)
local oldNamecall = mt.__namecall
setreadonly(mt, false)

mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local name = self.Name
    
    -- Daftar remote yang biasanya mengubah status jadi jahat
    if method == "FireServer" and (name:find("Criminal") or name:find("Wanted") or name:find("Crime")) then
        print("🛡️ BLOCKED: Mencegah perubahan status ke Criminal!")
        return nil
    end
    
    return oldNamecall(self, ...)
end)
setreadonly(mt, true)
