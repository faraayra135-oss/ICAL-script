-- Gunakan ini saat memegang senjata ACS
local function ModACS()
    local Tool = game.Players.LocalPlayer.Character:FindFirstChildWhichIsA("Tool")
    local Settings = Tool and (Tool:FindFirstChild("ACS_Settings") or Tool:FindFirstChild("Settings"))
    
    if Settings then
        for _, v in pairs(Settings:GetChildren()) do
            if v:IsA("ModuleScript") then
                local Data = require(v)
                -- Modifikasi Stat Senjata
                Data.RecoilData = {0,0,0,0,0,0} -- Tanpa Getaran
                Data.MinSpread = 0              -- Akurasi Laser
                Data.MaxSpread = 0
                Data.Ammo = 999                 -- Peluru tak terbatas
                Data.StoredAmmo = 999
                print("🔥 Senjata " .. Tool.Name .. " telah di-buff!")
            end
        end
    end
end

ModACS()
