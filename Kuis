--- LOGIKA DATA & REMOTE ---
local WordList = {}
local kataSudahDipakai = {}
local RS = game:GetService("ReplicatedStorage")
local Remotes = RS:WaitForChild("Remotes")

local SubmitRemote = Remotes:WaitForChild("SubmitWord")
local BillboardRemote = Remotes:WaitForChild("BillboardUpdate")
local TypeSoundRemote = Remotes:WaitForChild("TypeSound")

task.spawn(function()
    local WLFolder = RS:WaitForChild("WordList")
    WordList = require(WLFolder:WaitForChild("IndonesianWords"))
end)

-- DAFTAR AKHIRAN SKAKMAT (X Prioritas Utama)
local daftarMematikan = {
    {suffix = "x", skor = 500},  -- Lawan harus cari depan X (Sangat Sulit)
    {suffix = "nz", skor = 100}, -- Lawan harus cari depan Z
    {suffix = "sy", skor = 95},  -- Lawan harus cari depan SY
    {suffix = "kh", skor = 90},  -- Lawan harus cari depan KH
    {suffix = "q", skor = 85},   
    {suffix = "z", skor = 80},   
}

local function cariKataTerbaik()
    local prefixInput = string.lower(InputBox.Text)
    if #prefixInput == 0 or #WordList == 0 then return nil end
    
    local hasilCari = {}
    for _, v in ipairs(WordList) do
        local w = string.lower(v)
        if string.sub(w, 1, #prefixInput) == prefixInput and #w > #prefixInput and not kataSudahDipakai[w] then
            local skor = 0
            for _, data in ipairs(daftarMematikan) do
                if string.sub(w, -#data.suffix) == data.suffix then
                    skor = data.skor
                    break
                end
            end
            table.insert(hasilCari, {teks = w, poin = skor})
        end
    end
    table.sort(hasilCari, function(a, b) return a.poin > b.poin end)
    return #hasilCari > 0 and hasilCari[1].teks or nil
end

local function prosesEkseskusi(target, originalPrefix)
    StatusLabel.Text = "Mengunci target..."
    task.wait(math.random(10, 18) / 10) 

    for i = #originalPrefix + 1, #target do
        local partial = string.sub(target, 1, i)
        
        BillboardRemote:FireServer(partial)
        TypeSoundRemote:FireServer() -- Suara ketik otomatis beruntun
        
        task.wait(math.random(25, 55) / 100) -- Mengetik lambat & natural
    end
    
    task.wait(math.random(6, 12) / 10)
    SubmitRemote:FireServer(target)
    
    kataSudahDipakai[target] = true
    local count = 0; for _ in pairs(kataSudahDipakai) do count = count + 1 end
    ResetBtn.Text = "RESET MEMORY (" .. count .. ")"
    StatusLabel.Text = "Skakmat: " .. target
end

--- UI EVENTS ---
InputBox.FocusLost:Connect(function(enter)
    if enter then
        local pfx = InputBox.Text
        local target = cariKataTerbaik()
        if target then
            InputBox.Text = ""
            task.spawn(function() prosesEkseskusi(target, pfx) end)
        else
            StatusLabel.Text = "X tidak tersedia!"
        end
    end
end)

