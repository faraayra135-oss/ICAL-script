-- SISTEM DATA & REMOTE
local WordList = {}
_G.kataSudahDipakai = {} -- Menggunakan variabel global agar lebih stabil
local RS = game:GetService("ReplicatedStorage")
local Remotes = RS:WaitForChild("Remotes")
local SubmitRemote = Remotes:WaitForChild("SubmitWord")
local BillboardRemote = Remotes:WaitForChild("BillboardUpdate")
local TypeSoundRemote = Remotes:WaitForChild("TypeSound")

task.spawn(function()
    local WLFolder = RS:WaitForChild("WordList")
    WordList = require(WLFolder:WaitForChild("IndonesianWords"))
end)

-- SISTEM RAINBOW
local isTyping = false
task.spawn(function()
    while true do
        if isTyping then
            for i = 0, 1, 0.01 do
                if not isTyping then break end
                StatusLabel.TextColor3 = Color3.fromHSV(i, 1, 1)
                task.wait(0.02)
            end
        else
            StatusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            task.wait(0.5)
        end
    end
end)

local function updateResetText()
    local count = 0
    for _ in pairs(_G.kataSudahDipakai) do count = count + 1 end
    ResetBtn.Text = "RESET MEMORY (" .. count .. ")"
end

local function cariKataTerbaik()
    local prefixInput = string.lower(InputBox.Text)
    if #prefixInput == 0 or #WordList == 0 then return nil end
    local hasilCari = {}
    for _, v in ipairs(WordList) do
        local w = string.lower(v)
        if string.sub(w, 1, #prefixInput) == prefixInput and #w > #prefixInput and not _G.kataSudahDipakai[w] then
            local skor = 0
            if string.sub(w, -1) == "x" then skor = 500
            elseif string.sub(w, -2) == "nz" then skor = 100
            elseif string.sub(w, -2) == "sy" then skor = 95
            elseif string.sub(w, -2) == "kh" then skor = 90
            end
            table.insert(hasilCari, {teks = w, poin = skor})
        end
    end
    table.sort(hasilCari, function(a, b) return a.poin > b.poin end)
    return #hasilCari > 0 and hasilCari[1].teks or nil
end

local function prosesEkseskusi(target, originalPrefix)
    isTyping = true
    StatusLabel.Text = "Mencari Kata Hati Ical..."
    task.wait(math.random(10, 15) / 10) 

    for i = #originalPrefix + 1, #target do
        local partial = string.sub(target, 1, i)
        BillboardRemote:FireServer(partial)
        TypeSoundRemote:FireServer() 
        task.wait(math.random(25, 50) / 100) 
    end
    
    task.wait(math.random(5, 10) / 10)
    SubmitRemote:FireServer(target)
    
    _G.kataSudahDipakai[target] = true
    isTyping = false
    updateResetText()
    StatusLabel.Text = "Mampus Kau: " .. target
    StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
end

-- FIX TOMBOL RESET
ResetBtn.MouseButton1Click:Connect(function() 
    _G.kataSudahDipakai = {} -- Kosongkan tabel
    updateResetText()
    StatusLabel.Text = "Memory Bersih!"
    StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 255)
    print("Memory has been reset.") -- Cek di F9
end)

InputBox.FocusLost:Connect(function(enter)
    if enter then
        local pfx = InputBox.Text
        local target = cariKataTerbaik()
        if target then
            InputBox.Text = ""
            task.spawn(function() prosesEkseskusi(target, pfx) end)
        else
            StatusLabel.Text = "Kata tidak ditemukan!"
        end
    end
end)

