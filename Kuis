    InputBox.Visible, StatusLabel.Visible, ResetBtn.Visible = not minimized, not minimized, not minimized
    MinimizeBtn.Text = minimized and "+" or "-"
end)

ResetBtn.MouseButton1Click:Connect(function() 
    kataSudahDipakai = {} 
    ResetBtn.Text = "RESET MEMORY (0)"
    StatusLabel.Text = "Memory Direset!"
end)
