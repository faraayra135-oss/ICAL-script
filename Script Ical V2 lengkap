-- 5. ESP WALLHACK (DENGAN FITUR MINIMIZE)
CreateBtn("5. ESP Wallhack", Color3.fromRGB(130, 40, 180), function()
    if CoreGui:FindFirstChild("ESPGUI_V3") then CoreGui.ESPGUI_V3:Destroy() end

    local ScreenGuiESP = Instance.new("ScreenGui", CoreGui)
    ScreenGuiESP.Name = "ESPGUI_V3"

    local ESPFrame = Instance.new("Frame", ScreenGuiESP)
    ESPFrame.Size = UDim2.new(0, 120, 0, 100)
    ESPFrame.Position = UDim2.new(0.7, 0, 0.3, 0)
    ESPFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    ESPFrame.Active = true
    ESPFrame.Draggable = true
    Instance.new("UICorner", ESPFrame)

    local ESPTitle = Instance.new("TextLabel", ESPFrame)
    ESPTitle.Size = UDim2.new(1, 0, 0, 25)
    ESPTitle.Text = "ESP MENU"
    ESPTitle.TextColor3 = Color3.fromRGB(255,255,255)
    ESPTitle.BackgroundColor3 = Color3.fromRGB(50,50,50)
    ESPTitle.TextSize = 10
    Instance.new("UICorner", ESPTitle)

    -- Tombol Minimize ESP
    local ESPMinBtn = Instance.new("TextButton", ESPTitle)
    ESPMinBtn.Size = UDim2.new(0, 18, 0, 18)
    ESPMinBtn.Position = UDim2.new(1, -22, 0, 3)
    ESPMinBtn.Text = "-"
    ESPMinBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    ESPMinBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    Instance.new("UICorner", ESPMinBtn)

    -- Tombol Buka ESP (Saat di-minimize)
    local ESPOpenBtn = Instance.new("TextButton", ScreenGuiESP)
    ESPOpenBtn.Size = UDim2.new(0, 35, 0, 35)
    ESPOpenBtn.Position = UDim2.new(0.02, 0, 0.55, 0)
    ESPOpenBtn.Text = "E"
    ESPOpenBtn.BackgroundColor3 = Color3.fromRGB(130, 40, 180)
    ESPOpenBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    ESPOpenBtn.Visible = false
    ESPOpenBtn.Active = true
    ESPOpenBtn.Draggable = true
    Instance.new("UICorner", ESPOpenBtn)
    Instance.new("UIStroke", ESPOpenBtn).Color = Color3.fromRGB(255, 255, 255)

    ESPMinBtn.MouseButton1Click:Connect(function()
        ESPFrame.Visible = false
        ESPOpenBtn.Visible = true
    end)
    ESPOpenBtn.MouseButton1Click:Connect(function()
        ESPFrame.Visible = true
        ESPOpenBtn.Visible = false
    end)

    local ESPToggle = Instance.new("TextButton", ESPFrame)
    ESPToggle.Size = UDim2.new(0.8, 0, 0.4, 0)
    ESPToggle.Position = UDim2.new(0.1, 0, 0.45, 0)
    ESPToggle.Text = "ESP: OFF"
    ESPToggle.BackgroundColor3 = Color3.fromRGB(60,60,60)
    ESPToggle.TextColor3 = Color3.fromRGB(255,255,255)
    Instance.new("UICorner", ESPToggle)

    local espEnabled = false
    local function HandleESP(plr)
        if plr == LocalPlayer or not plr.Character then return end
        if plr.Character:FindFirstChild("ESPHl") then plr.Character.ESPHl:Destroy() end
        if plr.Character:FindFirstChild("ESPNm") then plr.Character.ESPNm:Destroy() end

        local hl = Instance.new("Highlight", plr.Character)
        hl.Name = "ESPHl"
        hl.FillColor = Color3.fromRGB(255,0,0)
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop

        local bg = Instance.new("BillboardGui", plr.Character)
        bg.Name = "ESPNm"
        bg.Adornee = plr.Character:FindFirstChild("Head")
        bg.Size = UDim2.new(0, 80, 0, 40)
        bg.AlwaysOnTop = true
        bg.StudsOffset = Vector3.new(0, 2, 0)

        local txt = Instance.new("TextLabel", bg)
        txt.Size = UDim2.new(1,0,1,0)
        txt.BackgroundTransparency = 1
        txt.Text = plr.Name
        txt.TextColor3 = Color3.fromRGB(255,255,0)
        txt.TextSize = 10
        txt.Font = Enum.Font.GothamBold
    end

    ESPToggle.MouseButton1Click:Connect(function()
        espEnabled = not espEnabled
        ESPToggle.Text = espEnabled and "ESP: ON" or "ESP: OFF"
        ESPToggle.BackgroundColor3 = espEnabled and Color3.fromRGB(0,200,100) or Color3.fromRGB(60,60,60)
        if not espEnabled then
            for _, v in pairs(Players:GetPlayers()) do
                if v.Character then
                    if v.Character:FindFirstChild("ESPHl") then v.Character.ESPHl:Destroy() end
                    if v.Character:FindFirstChild("ESPNm") then v.Character.ESPNm:Destroy() end
                end
            end
        end
    end)

    RunService.RenderStepped:Connect(function()
        if espEnabled then
            for _, v in pairs(Players:GetPlayers()) do
                if v ~= LocalPlayer and v.Character and not v.Character:FindFirstChild("ESPHl") then
                    HandleESP(v)
                end
            end
        end
    end)
end)

